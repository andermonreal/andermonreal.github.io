# Bundler cache
.bundle
vendor

# Gemfile.lock is committed on purpose: it pins jekyll-theme-chirpy (and its
# Font Awesome version) so CI/production builds are reproducible and don't
# silently drift to a newer theme release on every deploy.

# Jekyll cache
.jekyll-cache
.jekyll-metadata
_site

# RubyGems
*.gem

# NPM dependencies
node_modules
package-lock.json

# IDE configurations
.idea
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json

# Misc
_sass/vendors
assets/js/dist
